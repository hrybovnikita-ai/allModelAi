# Used by: npm run build:capacitor (vite build --mode capacitor)
VITE_DISABLE_PWA=true
VITE_CAPACITOR_NATIVE=true

# --- iPad / iPhone (real device) ---
# Same Wi‑Fi as your PC: set your PC LAN IP (ipconfig → IPv4), backend on port 5050.
# Example: VITE_IOS_API_URL=http://192.168.1.42:5050
# VITE_LAN_API_URL=http://192.168.1.42:5050

# --- Hosted API (works on iPad without a local PC) ---
VITE_CAPACITOR_USE_PRODUCTION=true
VITE_PRODUCTION_API_URL=https://all-model-ai.vercel.app

# --- Android emulator only (do not use on iPad) ---
# VITE_ANDROID_EMULATOR_API_URL=http://10.0.2.2:5050
