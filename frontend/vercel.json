{
  "installCommand": "cd .. && npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/__/auth",
      "destination": "https://allmodelai.firebaseapp.com/__/auth"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://allmodelai.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://allmodelai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/__/auth",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/__/auth/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/((?!api/|__/).*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ]
}
