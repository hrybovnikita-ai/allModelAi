{
  "installCommand": "cd .. && npm ci",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://allmodelai.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://allmodelai-backend.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://allmodelai-backend.onrender.com/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/__/auth/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
