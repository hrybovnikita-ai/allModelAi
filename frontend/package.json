{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "description": "AllModelAI Desktop App",
  "author": "Nikita Hrybov",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "vite build",
    "build:capacitor": "npm run prebuild && vite build --mode capacitor && npx cap sync",
    "build:ios": "npm run prebuild && vite build --mode capacitor && npx cap sync ios",
    "build:ios:open": "npx cap open ios",
    "build:android": "npm run prebuild && vite build --mode capacitor && npx cap sync android",
    "build:android:apk": "npm run build:android && node scripts/cap-android-build.mjs",
    "build:electron": "npm run prebuild && vite build --mode electron",
    "build:win": "npm run build:electron && electron-builder build --win nsis --x64 --publish never",
    "build:win:portable": "npm run build:electron && electron-builder --win portable",
    "build:mac": "npm run build:electron && electron-builder --mac --x64 --arm64",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http-get://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "lint": "eslint .",
    "test": "node scripts/run-all-tests.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@paddle/paddle-js": "^1.6.5",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "axios": "^1.12.2",
    "firebase": "^12.19.0",
    "pdfjs-dist": "^6.3.289",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.1",
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-linuxmusl-x64": "0.34.5",
    "@img/sharp-win32-x64": "0.34.5",
    "@rolldown/binding-darwin-arm64": "1.2.5",
    "@rolldown/binding-linux-x64-gnu": "1.2.5",
    "@rolldown/binding-linux-x64-musl": "1.2.5",
    "@rolldown/binding-win32-x64-msvc": "1.2.5",
    "@rollup/rollup-darwin-arm64": "4.63.5",
    "@rollup/rollup-linux-x64-gnu": "4.63.5",
    "@rollup/rollup-linux-x64-musl": "4.63.5",
    "@rollup/rollup-win32-x64-gnu": "4.63.5",
    "@rollup/rollup-win32-x64-msvc": "4.63.5",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "25.1.8",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.allmodelai.app",
    "productName": "AllModelAI",
    "electronVersion": "35.7.5",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "AllModelAI-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "AllModelAI-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "backgroundColor": "#080b12"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
