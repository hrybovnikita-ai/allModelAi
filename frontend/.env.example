# Public Firebase web app configuration (Firebase console > Project settings > Your apps > Web).
# Enable Google sign-in in Firebase console > Authentication > Sign-in method.
# Authorized domains: localhost, your production domain, capacitor://localhost, https://localhost
# OAuth redirect (redirect sign-in): https://YOUR_DOMAIN/auth/callback and http://localhost:5173/auth/callback
# Optional public GitHub OAuth Client ID (same app as backend GITHUB_CLIENT_ID / Firebase GitHub provider).
VITE_GITHUB_CLIENT_ID=

# Required for Google sign-in on Vercel/static builds (redeploy after setting).
# Local dev: you can instead set FIREBASE_WEB_* in backend/.env; the login page loads them from GET /api/public/firebase-config.
VITE_FIREBASE_API_KEY=
# Firebase Auth domain (must match where /__/auth/handler is reachable).
# Production Safari/iPad (Vercel proxy in vercel.json): use your site hostname, NOT *.firebaseapp.com:
# Production custom domain (required if users open https://all-model-ai.com):
#   VITE_FIREBASE_AUTH_DOMAIN=all-model-ai.com
# Or leave authDomain as *.firebaseapp.com — hosted HTTPS sites auto-use the live hostname when /__/auth is proxied (see vercel.json).
# Firebase Console → Authentication → Settings → Authorized domains: add all-model-ai.com, www.all-model-ai.com, all-model-ai.vercel.app
# Google Cloud → OAuth client → Authorized JavaScript origins: https://all-model-ai.com (and www if used)
# Authorized redirect URIs must include: https://all-model-ai.com/__/auth/handler and https://<project>.firebaseapp.com/__/auth/handler
# Alternative: keep firebaseapp.com in backend API config and set:
#   VITE_FIREBASE_CUSTOM_AUTH_DOMAIN=true
# (uses window.location.hostname on production web only; requires /__/auth rewrite)
# Local dev with custom domain testing: Vite proxies /__/auth → firebaseapp.com (vite.config.js).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_CUSTOM_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional (not required by current firebase.js, but useful in Firebase console):
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

# Production public site URL (no trailing slash). Used for native builds and OAuth docs.
# Example: https://all-model-ai.com (also keep https://all-model-ai.vercel.app working via CORS)
VITE_PUBLIC_APP_URL=

# Leave EMPTY for production web (all-model-ai.com / Vercel). The SPA must call same-origin /api/*
# (see frontend/vercel.json) so Safari treats the HttpOnly session cookie as first-party.
# Do NOT set this to https://allmodelai-backend.onrender.com on Vercel — iOS Safari will block the cookie.
# Only set for Capacitor/native builds (.env.capacitor) or local dev without the Vite proxy.
# Example (native only): VITE_API_BASE_URL=https://allmodelai-backend.onrender.com
VITE_API_BASE_URL=

# Optional local Vite proxy override:
API_PROXY_TARGET=http://127.0.0.1:5050
# Native Android/iOS: npm run build:capacitor (see .env.capacitor — bakes VITE_API_BASE_URL into the app)
# VITE_API_BASE_URL=http://10.0.2.2:5050
# Runtime default when unset on native: http://10.0.2.2:5050
# VITE_ANDROID_EMULATOR_API_URL=http://10.0.2.2:5050
# Store / production native builds:
# VITE_CAPACITOR_USE_PRODUCTION=true
# VITE_PRODUCTION_API_URL=https://all-model-ai.vercel.app
# Local dev: show test banner and block real WayForPay redirects (set false for production builds with live payments)
VITE_WAYFORPAY_TEST_MODE=true
# Set true when building an installable app shell (hides User/Developer toggle in chat):
# VITE_STANDALONE_APP=true
# Stripe publishable key (copy from backend or run `npm run stripe:sync` in backend folder):
VITE_STRIPE_PUBLISHABLE_KEY=
