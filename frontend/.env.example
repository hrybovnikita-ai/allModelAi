# Public Firebase web app configuration (Firebase console > Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=allmodelai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=allmodelai
VITE_FIREBASE_APP_ID=
# Optional local Vite proxy override:
API_PROXY_TARGET=http://127.0.0.1:5050
# Native Android/iOS builds use `npm run build:capacitor` (.env.capacitor disables PWA service worker).
# Capacitor / Android: absolute API origin (overrides native defaults below)
# VITE_API_BASE_URL=https://all-model-ai.vercel.app
# Native default production API when VITE_API_BASE_URL is unset:
# VITE_PRODUCTION_API_URL=https://all-model-ai.vercel.app
# Android emulator → host machine backend (port 5050) when local API is enabled:
# VITE_CAPACITOR_USE_LOCAL_API=true
# VITE_ANDROID_EMULATOR_API_URL=http://10.0.2.2:5050
# Local dev: show test banner and block real WayForPay redirects (set false for production builds with live payments)
VITE_WAYFORPAY_TEST_MODE=true
# Set true when building an installable app shell (hides User/Developer toggle in chat):
# VITE_STANDALONE_APP=true
# Stripe publishable key (copy from backend or run `npm run stripe:sync` in backend folder):
VITE_STRIPE_PUBLISHABLE_KEY=
