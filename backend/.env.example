# SQLite database path, relative to backend/ or absolute. Tables are created automatically.
# DB_FILE=storage/database.sqlite
#
# --- PostgreSQL / Supabase (primary: DATABASE_URL) ---
# Copy this file to backend/.env (gitignored). Paste your real Session pooler URI into DATABASE_URL.
# Do NOT use DATABASE_URL_API_KEY or POSTGRESS_URL_API_KEY — they are ignored.
#
# Example structure only (replace [YOUR-PASSWORD] locally; never commit real credentials):
# postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:5432/postgres
#
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=false
#
# Aliases (only if DATABASE_URL is unset): POSTGRES_URL, POSTGRES_CONNECTION_STRING, SUPABASE_DATABASE_URL
# Do not append sslmode to DATABASE_URL — TLS is configured via DATABASE_SSL_MODE / DATABASE_SSL_REJECT_UNAUTHORIZED.
# DATABASE_SSL_MODE=require
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA_FILE=/path/to/supabase-ca.crt
# DATABASE_POOL_MAX=10
#
# npm run auth:config-check
# npm run auth:check-user -- --email="you@example.com" --require-postgres
# Frontend origin allowed to send cookies. Comma-separated list is supported.
# For LAN testing (phone on same Wi‑Fi), add your machine IP, e.g. http://192.168.1.5:5173
# Private LAN origins are also allowed automatically when NODE_ENV is not production.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: allow http://192.168.x.x origins when NODE_ENV=production (staging only)
# CORS_ALLOW_LOCAL_NETWORK=true
# Backend bind address (0.0.0.0 = reachable on local network)
HOST=0.0.0.0
# Production HTTPS split deploy (frontend on Vercel, API on Render): set FRONTEND_ORIGIN to the
# exact browser origin(s), COOKIE_SECURE=true, and include the same origins in CORS allowlist.
# Frontend VITE_API_BASE_URL must use https:// (not http://) for the Render backend to avoid
# platform HTTP→HTTPS 307 redirects that break CORS preflight.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# Capacitor WebView origins (also built-in: https://localhost, capacitor://localhost)
# NATIVE_APP_ORIGINS=https://localhost,capacitor://localhost
# Public HTTPS URL after cloud deploy, for example https://allmodelai.onrender.com
# PUBLIC_URL=https://your-app.onrender.com
# On Vercel only (backend service env): HTTPS origin of the durable backend deployed with render.yaml
# (or a single backend instance with a persistent disk). Never point this at Vercel itself.
# PERSISTENT_BACKEND_ORIGIN=https://your-backend.onrender.com
# On the durable backend (Render/Docker): set FRONTEND_ORIGIN to every browser origin that calls the
# API (comma-separated), and PUBLIC_URL to your canonical public site, for example:
# FRONTEND_ORIGIN=https://all-model-ai.com,https://www.all-model-ai.com,https://all-model-ai.vercel.app
# PUBLIC_URL=https://all-model-ai.com
# BACKEND_PUBLIC_URL=https://allmodelai-backend.onrender.com
# Listen on every network interface so phones on the LAN and cloud hosts can connect.
HOST=0.0.0.0
# Google Cloud OAuth web application credentials.
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback
# BACKEND_ORIGIN=http://localhost:5050
# Optional local-only account picker. Never enable this in production.
# ENABLE_DEMO_SOCIAL_AUTH=true
# Sign-in always verifies passwords and never auto-creates users (development and production).
# Registration is the only email/password path that creates accounts.
# ENFORCE_CREDIT_LIMITS=true
# IMAGE_API_KEY=your_openai_image_api_key
# IMAGE_MODEL=gpt-image-1
# Comfy Cloud (https://cloud.comfy.org) — server-only API key from platform.comfy.org/profile/api-keys
# COMFY_CLOUD_API_KEY=   (alias: COMFYUI_API_KEY)
# COMFY_CLOUD_BASE_URL=https://cloud.comfy.org
# COMFY_CLOUD_CHECKPOINT=flux1-schnell-fp8.safetensors
# COMFY_CLOUD_WORKFLOW_PATH=workflows/comfy-cloud-flux-schnell.api.json
# IMAGE_PROVIDER=comfy-cloud
# Optional: COMFY_CLOUD_AUTH_HEADER=bearer (default uses X-API-Key)
# IMAGE_PROVIDER=cloudflare
# Pollinations (https://enter.pollinations.ai/keys) — server-only sk_ key, never in frontend.
# POLLINATIONS_API_KEY=sk_your_pollinations_secret_key
# POLINATIONS_API_KEY is also accepted (typo alias).
# IMAGE_PROVIDER=pollinations
# POLLINATIONS_IMAGE_MODEL=flux
# HD and Ultra upgrade the Pollinations model. Standard stays on POLLINATIONS_IMAGE_MODEL.
# HD default: gptimage at 1024x1024, 1536x1024, or 1024x1536 with quality=high.
# Ultra default: gpt-image-2 with quality=hd (highest tier on Pollinations GPT Image models).
# POLLINATIONS_HD_MODEL=gptimage
# POLLINATIONS_ULTRA_MODEL=gptimage-large
# POLLINATIONS_API_URL=https://gen.pollinations.ai
# Optional external upscaler. Pollinations has no upscale endpoint; leave these unset until one is connected.
# UPSCALE_API_URL=
# UPSCALE_API_KEY=
# Cloudflare Workers AI — image generation (server-only; set on Render backend, not Vercel)
# IMAGE_GENERATION_PROVIDER=cloudflare
# IMAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CF_ACCOUNT_ID=alias_for_account_id
# CLOUDFLARE_API_TOKEN=your_workers_ai_api_token
# CLOUDFLARE_API_KEY=legacy_alias_for_api_token
# AllModelAi_API_KEY_IMAGE=optional_alias_for_cloudflare_api_token
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Optional: allow fallback to Pollinations/OpenAI after Cloudflare fails
# IMAGE_ALLOW_FALLBACK=false

# Welcome email after registration. Create a key and verify your sender domain at Resend.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=AllModelAI <welcome@your-domain.com>

# Tavily Search (Deep Research). Server-only — never expose to frontend or VITE_* vars.
# TAVILY_API_KEY=tvly-your_tavily_api_key

# Google Gemini API key. Keep the real key only in backend/.env.
# Google AI Studio — chat, vision, Deep Research, and Veo video (server-only, never VITE_*)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# GEMINI_VIDEO_POLL_MS=10000
# GEMINI_VIDEO_TIMEOUT_MS=600000
# Set this while OpenAI billing is unavailable to route GPT requests directly to Gemini.
# PREFER_GEMINI=true
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_MODEL=gemini-2.5-flash
# ADMIN_KEY=replace_with_a_private_admin_key
# Comma-separated accounts that can activate plans without payment while developing.
# DEVELOPER_EMAILS=hrybovnikita@gmail.com

# Stripe — https://dashboard.stripe.com/test/apikeys
# After filling keys: npm run stripe:check && npm run stripe:sync
# Global payment mode: test | live (defaults from provider test flags when unset)
# PAYMENT_MODE=test
# Primary checkout provider when both are configured: wayforpay | stripe
# PAYMENT_PROVIDER=wayforpay

# Development: STRIPE_MODE=test and sk_test_ / pk_test_ keys only (no real charges).
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional subscription Price IDs (otherwise dynamic price_data is used):
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_ENTERPRISE_PRICE_ID=price_...
# Prefer Stripe embedded checkout when WayForPay is also configured:
# STRIPE_CHECKOUT_WHEN_WAYFORPAY=true
# Public site hostname for Apple Pay / Google Pay (optional; auto-detected from APP origin in production).
# STRIPE_PAYMENT_DOMAIN=yourdomain.com

# WayForPay — https://wiki.wayforpay.com/view/852102
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
# Merchant domain (WAYFORPAY_DOMAIN is accepted as alias)
WAYFORPAY_MERCHANT_DOMAIN=all-model-ai.vercel.app
WAYFORPAY_DOMAIN=all-model-ai.vercel.app
WAYFORPAY_CURRENCY=USD
# Default: true — mock checkout only, no real charges
WAYFORPAY_TEST_MODE=true
# Required before real charges when WAYFORPAY_TEST_MODE=false
# WAYFORPAY_LIVE_CONFIRM=true
# Comma-separated emails allowed to run owner-only sandbox checkout (also users with role=owner in DB)
# PAYMENT_OWNER_EMAILS=you@example.com
BACKEND_PUBLIC_URL=https://your-backend-host.example
# Keep Stripe for chat/legacy only; paid /checkout uses WayForPay when configured
# STRIPE_CHECKOUT_WHEN_WAYFORPAY=true
# After registering the domain in Stripe, host the verification file at:
# frontend/public/.well-known/apple-developer-merchantid-domain-association
# Comma-separated fallback order when a selected gateway model is unavailable.
# OPENROUTER_FALLBACK_MODELS=gpt,gemini,mistral,deepseek,llama

# Official OpenAI API. Keep the real key only in backend/.env.
# Create it at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# OPEN_AI_API_KEY is also accepted for compatibility with older local setups.
# Balanced current model; replace only with a model available to your project.
OPENAI_MODEL=gpt-5.6-luna
# Optional: model for ai_python OpenAI dataset augmentation (PyTorch Lab).
# OPENAI_TRAINING_MODEL=gpt-4o-mini
# AI Training tutor (falls back to OpenRouter if OPENAI_API_KEY is unset).
# AI_TRAINING_TUTOR_OPENROUTER_MODEL=openrouter/free
# AI_TRAINING_MAX_EPOCHS=2000
# AI_TRAINING_MAX_DATA_POINTS=256
# AI_TRAINING_TIMEOUT_MS=45000
# AI_TRAINING_MAX_CONCURRENT=3
# PyTorch / Model Lab Python service (FastAPI). Node proxies /api/training/* to this URL.
# AI_PYTHON_PORT=5055
# PYTHON_BIN=python
# Optional Python LLM layer (same FastAPI process): /llm/chat on the Python service.
# Node proxies /api/python-llm/* when authenticated. Main /api/chat stays on Node (OpenRouter unchanged).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# KIMI_API_KEY=
# ENABLE_OPENAI_FINE_TUNING=false

# Dedicated production OpenRouter key for AllModelAI (preferred when set).
ALLMODELAI_OPENROUTER_API_KEY=
# OpenRouter API key. Keep the real key in .env and never commit it.
OPENROUTER_API_KEY=your_openrouter_api_key
# Simple DeepSeek free chat (POST /api/chat/deepseek): deepseek/deepseek-v4-flash:free via OpenRouter
# API_KEY is also supported for backwards compatibility.
# API_KEY=your_openrouter_api_key
# Optional Grok model override. Grok requests are sent through OpenRouter.
# GROK_MODEL=x-ai/grok-4.3
# Alternatively, connect Grok directly through xAI.
# XAI_API_KEY=your_xai_api_key
# GROK_API_KEY=your_grok_api_key
# XAI_MODEL=grok-4-latest
# AI_REQUEST_TIMEOUT_MS=45000

# Mistral AI direct API. Create a key at https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=your_mistral_api_key
# MISTRAL_MODEL=mistral-small-latest

CLAUDE_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Image generation key. OpenAI uses this key with the default image endpoint.
IMAGE_API_KEY=your_image_api_key
# Optional OpenAI-compatible image settings.
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024

# Optional: override the model selected by the chat UI.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# MAX_TOKENS=2048

# When DATABASE_URL is set, the backend uses PostgreSQL (Supabase Session Pooler in production).
# When unset, local development and tests use SQLite (DB_FILE). Production on Render requires DATABASE_URL
# unless ALLOW_SQLITE_PRODUCTION=true.
# REDIS_URL=redis://redis:6379
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# APP_VERSION=1.0.0
# EXPOSE_ACCOUNT_TOKENS=false

# Cloudflare Workers AI. CLAUDEFLARE_API_KEY is accepted as a legacy typo.
# CLOUDFLARE_API_KEY=your_cloudflare_api_token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Set false only for a trusted local network served over HTTP.
# Public HTTPS deployments should keep this true (the production default).
# COOKIE_SECURE=true
# HOST=0.0.0.0

# Enable JWT cookies with a random secret of at least 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# Optional shared cache. No URL uses an in-memory cache.
# REDIS_URL=redis://127.0.0.1:6379

# Use the region where your Moonshot key was issued.
# KIMI_API_KEY=your_moonshot_api_key
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# Mainland China (legacy default): https://api.moonshot.cn/v1
# Use OpenRouter for Grok while preserving the direct xAI key.
# GROK_PROVIDER=openrouter

# Route the selected Kimi version through OpenRouter instead of direct Moonshot billing.
# KIMI_PROVIDER=openrouter

# GitHub OAuth app (Firebase Authentication > Sign-in method > GitHub uses the same Client ID and Secret).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Social authentication (Firebase Admin verifies provider ID tokens). Never use VITE_ for Admin credentials.
FIREBASE_PROJECT_ID=
# Public Firebase web app config (safe to expose via GET /api/public/firebase-config). Use when VITE_FIREBASE_* is unset on the frontend build.
FIREBASE_WEB_API_KEY=
# Match frontend VITE_FIREBASE_AUTH_DOMAIN (default Firebase host).
FIREBASE_WEB_AUTH_DOMAIN=allmodelai.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service account private_key value. On Render use literal \n newlines or one line with \\n escapes.
FIREBASE_PRIVATE_KEY=
# Local dev fallback (never commit): backend/secrets/firebase-service-account.json
# Optional override path: FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Force source: FIREBASE_CREDENTIALS_SOURCE=env|file
# Browser origins allowed for POST /api/auth/firebase* (comma-separated). Must match where the React app runs.
FRONTEND_ORIGIN=http://localhost:5173
# Public site URL (production). Also used for cookies/CORS when deployed.
# PUBLIC_URL=https://your-production-domain
# BACKEND_URL=http://localhost:5050
