# SQLite database path. The default is storage/database.sqlite.
# DB_FILE=storage/database.sqlite
# Frontend origin allowed to send cookies.
FRONTEND_ORIGIN=http://localhost:5173
# Google Cloud OAuth web application credentials.
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback
# BACKEND_ORIGIN=http://localhost:5050
# Optional local-only account picker. Never enable this in production.
# ENABLE_DEMO_SOCIAL_AUTH=true
# Accept any non-empty password for an existing account during local development.
# Only loopback requests from this computer can use it.
# ALLOW_ANY_PASSWORD=true
# ENFORCE_CREDIT_LIMITS=true
# IMAGE_API_KEY=your_openai_image_api_key
# IMAGE_MODEL=gpt-image-1
# IMAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Welcome email after registration. Create a key and verify your sender domain at Resend.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=AllModelAI <welcome@your-domain.com>

# Google Gemini API key. Keep the real key only in backend/.env.
# GEMINI_API_KEY=your_gemini_api_key
# Set this while OpenAI billing is unavailable to route GPT requests directly to Gemini.
# PREFER_GEMINI=true
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_MODEL=gemini-2.5-flash
# ADMIN_KEY=replace_with_a_private_admin_key
# Comma-separated accounts that can activate plans without payment while developing.
# DEVELOPER_EMAILS=hrybovnikita@gmail.com

# Stripe hosted Checkout. Never expose these values in the frontend.
# STRIPE_SECRET_KEY=sk_test_your_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Official OpenAI API. Keep the real key only in backend/.env.
# Create it at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# OPEN_AI_API_KEY is also accepted for compatibility with older local setups.
# Balanced current model; replace only with a model available to your project.
OPENAI_MODEL=gpt-5.6-luna

# OpenRouter API key. Keep the real key in .env and never commit it.
OPENROUTER_API_KEY=your_openrouter_api_key
# API_KEY is also supported for backwards compatibility.
# API_KEY=your_openrouter_api_key
# Optional Grok model override. Grok requests are sent through OpenRouter.
# GROK_MODEL=x-ai/grok-4.3
CLAUDE_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Image generation key. OpenAI uses this key with the default image endpoint.
IMAGE_API_KEY=your_image_api_key
# Optional OpenAI-compatible image settings.
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024

# Optional: override the model selected by the chat UI.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# MAX_TOKENS=2048

# Production infrastructure. SQLite remains the local default; DATABASE_URL marks
# the deployment as ready for the PostgreSQL adapter/migration stage.
# DATABASE_URL=postgresql://allmodelai:password@postgres:5432/allmodelai
# REDIS_URL=redis://redis:6379
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# APP_VERSION=1.0.0
# EXPOSE_ACCOUNT_TOKENS=false

# Cloudflare Workers AI. CLAUDEFLARE_API_KEY is accepted as a legacy typo.
# CLOUDFLARE_API_KEY=your_cloudflare_api_token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
